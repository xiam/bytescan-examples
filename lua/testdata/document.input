-- A small module with every kind of token.
local M = {}

--[[
  M.greet returns a greeting.
]]
function M.greet(name, ...)
  local n = select('#', ...)
  if name == nil or #name == 0 then
    return "hello, world"
  elseif n > 0 then
    return ("hello, %s (+%d)"):format(name, n)
  end
  return [[hello, ]] .. name
end

local t = { x = 1.5e3, y = 0xFF, [1] = 'one' }
for i = 1, #t // 2 do t[i] = t[i] ~ 3 << 1 end
goto done
::done::
return M
