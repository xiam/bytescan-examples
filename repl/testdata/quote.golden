>
key 's': insert "s" at 0
change [0,0) -> [0,1), shift +1
+ WORD [0,1) "s"
  s
  W
key 'a': insert "a" at 1
change [0,1) -> [0,2), shift +1
- WORD [0,1) "s"
+ WORD [0,2) "sa"
  sa
  Ww
key 'y': insert "y" at 2
change [0,2) -> [0,3), shift +1
- WORD [0,2) "sa"
+ WORD [0,3) "say"
  say
  Www
key ' ': insert " " at 3
change [3,3) -> [3,4), shift +1
+ WS [3,4) " "
  say 
  Www
key '"': insert "\"" at 4
change [4,4) -> [4,5), shift +1
+ QUOTE [4,5) "\""
  say "
  Www Q
key enter: insert "\n" at 5
change [5,5) -> [5,6), shift +1
+ NL [5,6) "\n"
  say "
  Www Q
continue: the text ends in the mode str
...
key 'b': insert "b" at 6
change [6,6) -> [6,7), shift +1
+ TEXT [6,7) "b"
  say "
  Www Q
  b
  S
key 'y': insert "y" at 7
change [6,7) -> [6,8), shift +1
- TEXT [6,7) "b"
+ TEXT [6,8) "by"
  say "
  Www Q
  by
  Ss
key 'e': insert "e" at 8
change [6,8) -> [6,9), shift +1
- TEXT [6,8) "by"
+ TEXT [6,9) "bye"
  say "
  Www Q
  bye
  Sss
key '"': insert "\"" at 9
change [9,9) -> [9,10), shift +1
+ QUOTE [9,10) "\""
  say "
  Www Q
  bye"
  SssQ
key enter: insert "\n" at 10
change [10,10) -> [10,11), shift +1
+ NL [10,11) "\n"
  say "
  Www Q
  bye"
  SssQ
run
1:0 WORD "say"
1:3 WS " "
1:4 QUOTE "\""
